# ============================================================
# CONFIGURASI BOT TELEGRAM ADMIN
# ============================================================

# --- Telegram Bot (dari @BotFather) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Supabase (sama dengan backend NestJS) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- API Stockity (sama dengan backend) ---
STOCKITY_API_URL=https://api.stockity.id

# --- NestJS Backend URL (untuk webhook/notifikasi) ---
BACKEND_API_URL=http://localhost:3000

# --- Admin Bot Config ---
# Chat ID super admin yang bisa mengakses bot (dipisah koma, contoh: 123456789,987654321)
# Biarkan kosong untuk mode auto-register (super admin pertama yang /start)
SUPER_ADMIN_CHAT_IDS=

# Notifikasi channel/group ID (opsional - untuk broadcast notifikasi)
NOTIFICATION_CHANNEL_ID=

# --- Mode Operasi ---
# MODE: polling atau webhook
BOT_MODE=polling

# Webhook URL (hanya untuk mode webhook)
WEBHOOK_URL=https://your-vps-domain.com/webhook
WEBHOOK_PORT=8443

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# --- Deposit Detection ---
# Interval polling deposit detection (dalam detik)
DEPOSIT_CHECK_INTERVAL=300
# Minimum balance change untuk dianggap deposit (dalam satuan mata uang)
MIN_DEPOSIT_AMOUNT=1
